# --- BASE DE DATOS MONGODB ---
DB_URL=mongodb+srv://usuario:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# --- SEGURIDAD Y TOKEN ---
JWT_SECRET=tu_clave_secreta_jwt_aqui

# --- SERVIDOR Y CORS ---
PORT=3000
ENVIRONMENT=development
# Origenes del frontend que pueden llamar a esta API, separados por comas.
# Admite comodin, para los despliegues de preview que estrenan subdominio en
# cada build:
#   ALLOWED_ORIGINS=https://midominio.com,https://*.midominio.pages.dev
# Un `*` suelto abre la API a cualquier origen: solo para desarrollo.
ALLOWED_ORIGINS=http://localhost:5173

# --- CLOUDFLARE R2 (ALMACENAMIENTO DE ARCHIVOS/IMAGENES) ---
R2_ACCOUNT_ID=tu_account_id_de_cloudflare
R2_ACCESS_KEY_ID=tu_r2_access_key_id
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key
R2_BUCKET_NAME=assets
R2_PUBLIC_DOMAIN=http://localhost:3000/api/media

# --- STRIPE (TARJETA Y BIZUM) ---
# Bizum se cobra a traves de Stripe, no es una pasarela aparte. Hay que
# activarlo en el panel: Configuracion > Metodos de pago > Bizum. Solo admite
# euros y cuentas espanolas.
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_de_stripe
# Se obtiene al registrar el endpoint del webhook en el panel de Stripe,
# o con: stripe listen --forward-to localhost:3000/api/pedidos/webhook
STRIPE_WEBHOOK_SECRET=whsec_tu_secreto_de_webhook

# --- PAYPAL (PASARELA DE PAGO) ---
# Credenciales de la app REST, en developer.paypal.com > Apps & Credentials.
# Ojo: las credenciales de sandbox y las de produccion son distintas.
PAYPAL_CLIENT_ID=tu_client_id_de_paypal
PAYPAL_CLIENT_SECRET=tu_client_secret_de_paypal
# `live` apunta a la API real y cobra de verdad. Cualquier otro valor (o
# ausencia) usa el sandbox.
PAYPAL_ENTORNO=sandbox
# Id del webhook, en la misma app REST > Webhooks. Se registra apuntando a
#   <url-del-backend>/api/pedidos/webhook/paypal
# suscrito al evento CHECKOUT.ORDER.APPROVED. Sin este id no se puede verificar
# la firma y el webhook se rechaza entero: es lo que cierra el pago del cliente
# que aprueba y no vuelve al sitio.
PAYPAL_WEBHOOK_ID=

# --- CORREO TRANSACCIONAL (RECUPERACION DE CONTRASENA) ---
# Sin estas dos variables el servidor arranca igual y el flujo no falla: el
# correo simplemente no sale y queda avisado en el log.
# API key de resend.com > API Keys.
RESEND_API_KEY=
# Remitente. El dominio tiene que estar verificado en Resend; para probar sirve
# onboarding@resend.dev, que solo entrega a la cuenta dueña de la API key.
CORREO_REMITENTE=OSSA BJJ <no-reply@tudominio.com>
